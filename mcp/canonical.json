{
  "version": 1,
  "options": {
    "trae": {
      "httpViaMcpRemote": true
    }
  },
  "mcpServers": {
    "vercel": {
      "transport": "http",
      "url": "https://mcp.vercel.com"
    },
    "supabase": {
      "transport": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "mastergo": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mastergo/vibe-mcp",
        "--url=http://localhost:50678"
      ]
    }
  }
}
