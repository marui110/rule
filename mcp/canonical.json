{
  "version": 1,
  "options": {},
  "mcpServers": {
    "vercel": {
      "transport": "http",
      "url": "https://mcp.vercel.com"
    },
    "supabase": {
      "transport": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "firecrawl-mcp": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ]
    },
    "chrome-devtools": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ]
    },
    "context-mode": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "context-mode"
      ]
    }
  }
}
